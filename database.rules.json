{
  "rules": {
    "buildings": {
      ".read": true,
      ".write": false
    },
    "amenitiesByBuilding": {
      ".read": true,
      ".write": false
    },
    "amenitySubmissions": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        "$submissionId": {
          ".write": "auth != null && auth.uid === $userId && !data.exists() && newData.exists() && newData.child('userId').val() === auth.uid",
          ".validate": "newData.hasChildren(['userId', 'buildingId', 'amenityType', 'floorNumber', 'availability', 'createdAt']) && root.child('buildings').child('building_' + newData.child('buildingId').val()).exists()",
          "userId": {
            ".validate": "newData.isString() && newData.val() === auth.uid && newData.val().length <= 128"
          },
          "buildingId": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() % 1 === 0"
          },
          "amenityType": {
            ".validate": "newData.isString() && newData.val().matches(/^(restroom|waterRefillStation|vendingMachine|studySpace|lactationRoom|microwave|zeroWasteStation|eatery|campusGarden|basicNeedService|changingTable|menstrualProduct)$/)"
          },
          "floorNumber": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20 && newData.val() % 1 === 0"
          },
          "availability": {
            ".validate": "newData.isString() && newData.val().matches(/^(available|outOfService|unknown)$/)"
          },
          "locationDetails": {
            ".validate": "newData.isString() && newData.val().matches(/\\S/) && newData.val().length <= 200"
          },
          "notes": {
            ".validate": "newData.isString() && newData.val().matches(/\\S/) && newData.val().length <= 1000"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 10000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "reviewsByAmenity": {
      "$buildingId": {
        "$amenityBranch": {
          "$amenityId": {
            ".read": true,
            "$reviewId": {
              ".write": "auth != null && !data.exists() && root.child('amenitiesByBuilding').child($buildingId).child($amenityBranch).child($amenityId).exists() && newData.child('userId').val() === auth.uid",
              ".validate": "newData.hasChildren(['userId', 'authorName', 'rating', 'comment', 'createdAt'])",
              "userId": {
                ".validate": "newData.isString() && newData.val() === auth.uid && newData.val().length <= 128"
              },
              "authorName": {
                ".validate": "newData.isString() && ((auth.token.name != null && newData.val() === auth.token.name) || (auth.token.name == null && newData.val() === 'Campus user')) && newData.val().length > 0 && newData.val().length <= 100"
              },
              "authorPhotoURL": {
                ".validate": "newData.isString() && newData.val() === auth.token.picture && newData.val().matches(/^https:\\/\\//) && newData.val().length <= 2048"
              },
              "rating": {
                ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === 2 || newData.val() === 3 || newData.val() === 4 || newData.val() === 5)"
              },
              "comment": {
                ".validate": "newData.isString() && newData.val().matches(/\\S/) && newData.val().length <= 1000"
              },
              "createdAt": {
                ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 10000"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    },
    "userPreferences": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId && newData.exists()",
        ".validate": "newData.hasChildren(['gender'])",
        "gender": {
          ".validate": "newData.isString() && newData.val().matches(/^(Woman|Man|Non-binary|Prefer not to say)$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
